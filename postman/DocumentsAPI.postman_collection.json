              "pm.test(\"Status code is 400\", () => {\r",
              "    pm.response.to.have.status(400);\r",
              "})\r",
              "\r",
              "pm.test(\"Returns error message\", () => {\r",
              "    const body = pm.response.text();\r",
              "\r",
              "    pm.expect(body).to.include(\"The uploaded file does not contain valid text content.\");\r",
              "});"
            ],
