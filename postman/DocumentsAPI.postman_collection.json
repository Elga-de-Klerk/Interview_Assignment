  },
  "item": [
    {
      "name": "Mutate document (valid file)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "\r",
              "pm.test(\"Content-Type is text/plain\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.include(\"text/plain\");\r",
              "});\r",
              "\r",
              "pm.test(\"Timestamp and random sequence are present\", () => {\r",
              "    const body = pm.response.text();\r",
              "\r",
              "    pm.expect(body).to.include(\"Mutated on:\");\r",
              "    pm.expect(body).to.include(\"Random sequence:\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ["postman/valid-file.txt"]
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/Documents/mutate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Documents",
            "mutate"
          ]
        }
      },
      "response": []
    },
    {
