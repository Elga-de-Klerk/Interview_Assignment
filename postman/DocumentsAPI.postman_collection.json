          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", () => {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "pm.test(\"Contains error message\", () => {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    pm.expect(body.errors).to.have.property(\"file\");\r",
              "    pm.expect(body.errors.file[0]).to.include(\"The file field is required.\");\r",
              "});"
